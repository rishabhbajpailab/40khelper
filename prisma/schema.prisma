// 40k Helper data model
//
// Modelled on the current (10th edition style) datasheet layout:
//   Faction -> Detachments (rules, enhancements, stratagems)
//   Faction -> Datasheets  (model profiles, weapons, abilities, keywords, points)
//   User    -> Army lists  (units drawn from datasheets, with enhancements/leaders)
//
// Conventions:
//   * Models are PascalCase in Prisma and mapped to snake_case tables with @@map.
//   * Stats that can be dice expressions (A, D, sometimes M) are Strings ("D6+1", "2D3").
//   * Characteristics shown as "3+" (BS/WS/Sv) are stored as the integer target (3).
//   * Join tables use composite primary keys so duplicates are impossible.
//   * Reference ("rules") data cascades on delete; user data references rules with Restrict.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL") // app connection (may go through a pooler such as PgBouncer)
  directUrl         = env("DIRECT_URL") // direct connection used by Prisma Migrate
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum AbilityType {
  CORE // e.g. Deep Strike, Leader, Feel No Pain
  FACTION // e.g. Oath of Moment, Synapse
  DATASHEET // unique to the datasheet
  WARGEAR // granted by a piece of wargear
}

enum WeaponType {
  RANGED
  MELEE
}

enum StratagemCategory {
  BATTLE_TACTIC
  STRATEGIC_PLOY
  EPIC_DEED
  WARGEAR
}

enum GamePhase {
  COMMAND
  MOVEMENT
  SHOOTING
  CHARGE
  FIGHT
  ANY
}

enum BattlefieldRole {
  EPIC_HERO
  CHARACTER
  BATTLELINE
  DEDICATED_TRANSPORT
  FORTIFICATION
  OTHER
}

// ─────────────────────────────────────────────────────────────
// Factions & detachments
// ─────────────────────────────────────────────────────────────

model Faction {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(255)
  slug     String  @unique @db.VarChar(255)
  // Faction-wide army rule (e.g. "Oath of Moment")
  armyRule String?

  // Sub-factions, e.g. Blood Angels -> Space Marines
  parentId Int?
  parent   Faction?  @relation("FactionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Faction[] @relation("FactionHierarchy")

  detachments Detachment[]
  datasheets  Datasheet[]
  armyLists   ArmyList[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("factions")
}

model Detachment {
  id          Int     @id @default(autoincrement())
  factionId   Int
  name        String  @db.VarChar(255)
  rule        String? // detachment rule text
  description String?

  faction      Faction       @relation(fields: [factionId], references: [id], onDelete: Cascade)
  enhancements Enhancement[]
  stratagems   Stratagem[]
  armyLists    ArmyList[]

  @@unique([factionId, name])
  @@map("detachments")
}

// Replaces the old "relics" table.
model Enhancement {
  id           Int     @id @default(autoincrement())
  detachmentId Int
  name         String  @db.VarChar(255)
  points       Int
  description  String?
  // Free-text restriction, e.g. "INFANTRY model only"
  restriction  String?

  detachment    Detachment     @relation(fields: [detachmentId], references: [id], onDelete: Cascade)
  armyListUnits ArmyListUnit[]

  @@unique([detachmentId, name])
  @@map("enhancements")
}

// Stratagems belong to a detachment; core stratagems (Command Re-roll etc.) have no detachment.
model Stratagem {
  id           Int               @id @default(autoincrement())
  detachmentId Int?
  name         String            @db.VarChar(255)
  cpCost       Int
  category     StratagemCategory
  phase        GamePhase
  // "Your turn", "Opponent's turn", "Either player's turn"
  turn         String?           @db.VarChar(64)
  when         String?
  target       String?
  effect       String
  restrictions String?

  detachment Detachment? @relation(fields: [detachmentId], references: [id], onDelete: Cascade)

  @@unique([detachmentId, name])
  @@map("stratagems")
}

// ─────────────────────────────────────────────────────────────
// Datasheets (units)
// ─────────────────────────────────────────────────────────────

// Replaces the old "warhammer_units" table.
model Datasheet {
  id             Int             @id @default(autoincrement())
  factionId      Int
  name           String          @db.VarChar(255)
  slug           String          @db.VarChar(255)
  role           BattlefieldRole @default(OTHER)
  // Composition text, e.g. "1 Sergeant and 4-9 Intercessors"
  composition    String?
  wargearOptions String?
  baseSize       String?         @db.VarChar(64)
  lore           String?

  faction       Faction            @relation(fields: [factionId], references: [id], onDelete: Cascade)
  profiles      ModelProfile[]
  unitSizes     UnitSize[]
  weapons       DatasheetWeapon[]
  abilities     DatasheetAbility[]
  keywords      DatasheetKeyword[]
  // Leader rule: which bodyguard units this character can join, and vice versa
  canLead       LeaderAttachment[] @relation("Leader")
  canBeLedBy    LeaderAttachment[] @relation("Bodyguard")
  armyListUnits ArmyListUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([factionId, slug])
  @@map("datasheets")
}

// A datasheet can have more than one stat line (e.g. a sergeant or a vehicle with
// a separate profile). Most datasheets have exactly one.
model ModelProfile {
  id          Int    @id @default(autoincrement())
  datasheetId Int
  name        String @db.VarChar(255)
  movement    String @db.VarChar(16) // usually inches, e.g. "6", occasionally "20+"
  toughness   Int
  save        Int // 3 = 3+
  invulnSave  Int? // 4 = 4++
  wounds      Int
  leadership  Int // 6 = 6+
  oc          Int // Objective Control
  sortOrder   Int    @default(0)

  datasheet Datasheet @relation(fields: [datasheetId], references: [id], onDelete: Cascade)

  @@unique([datasheetId, name])
  @@map("model_profiles")
}

// Points cost by unit size, e.g. 5 models = 80pts, 10 models = 160pts.
model UnitSize {
  id          Int @id @default(autoincrement())
  datasheetId Int
  models      Int
  points      Int

  datasheet     Datasheet      @relation(fields: [datasheetId], references: [id], onDelete: Cascade)
  armyListUnits ArmyListUnit[]

  @@unique([datasheetId, models])
  @@map("unit_sizes")
}

// ─────────────────────────────────────────────────────────────
// Weapons
// ─────────────────────────────────────────────────────────────

// Replaces the old "ranged_weapons" / "melee_weapons" tables.
// A weapon has one or more profiles (e.g. frag / krak missile).
model Weapon {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(255)

  profiles   WeaponProfile[]
  datasheets DatasheetWeapon[]

  @@map("weapons")
}

model WeaponProfile {
  id       Int        @id @default(autoincrement())
  weaponId Int
  // Profile name; same as the weapon name when there is only one profile
  name     String     @db.VarChar(255)
  type     WeaponType
  range    Int? // inches; null = Melee
  attacks  String     @db.VarChar(16) // "2", "D6", "D6+3"
  skill    Int? // BS or WS target (3 = 3+); null for Torrent weapons
  strength Int
  ap       Int        @default(0) // stored as a non-positive number, e.g. -2
  damage   String     @db.VarChar(16) // "1", "D3", "D6+1"
  // Weapon abilities, e.g. {"ASSAULT", "RAPID FIRE 1", "LETHAL HITS"}
  keywords String[]

  weapon Weapon @relation(fields: [weaponId], references: [id], onDelete: Cascade)

  @@unique([weaponId, name])
  @@map("weapon_profiles")
}

model DatasheetWeapon {
  datasheetId Int
  weaponId    Int
  // true = part of the default loadout, false = available as an option
  isDefault   Boolean @default(true)

  datasheet Datasheet @relation(fields: [datasheetId], references: [id], onDelete: Cascade)
  weapon    Weapon    @relation(fields: [weaponId], references: [id], onDelete: Cascade)

  @@id([datasheetId, weaponId])
  @@map("datasheet_weapons")
}

// ─────────────────────────────────────────────────────────────
// Abilities & keywords
// ─────────────────────────────────────────────────────────────

// Replaces the old "abilities" and "auras" tables (auras are just abilities
// with the AURA keyword in the current rules).
model Ability {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(255)
  type        AbilityType
  description String?
  isAura      Boolean     @default(false)

  datasheets DatasheetAbility[]

  @@unique([name, type])
  @@map("abilities")
}

model DatasheetAbility {
  datasheetId Int
  abilityId   Int
  // Parameter for parameterised core abilities: "6\"" for Scouts, "D3" for Deadly Demise, "5+" for Feel No Pain
  value       String? @db.VarChar(32)

  datasheet Datasheet @relation(fields: [datasheetId], references: [id], onDelete: Cascade)
  ability   Ability   @relation(fields: [abilityId], references: [id], onDelete: Cascade)

  @@id([datasheetId, abilityId])
  @@map("datasheet_abilities")
}

model Keyword {
  id        Int     @id @default(autoincrement())
  name      String  @unique @db.VarChar(255)
  // Faction keywords (ADEPTUS ASTARTES) vs. regular keywords (INFANTRY, FLY)
  isFaction Boolean @default(false)

  datasheets DatasheetKeyword[]

  @@map("keywords")
}

model DatasheetKeyword {
  datasheetId Int
  keywordId   Int

  datasheet Datasheet @relation(fields: [datasheetId], references: [id], onDelete: Cascade)
  keyword   Keyword   @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([datasheetId, keywordId])
  @@map("datasheet_keywords")
}

model LeaderAttachment {
  leaderId    Int
  bodyguardId Int

  leader    Datasheet @relation("Leader", fields: [leaderId], references: [id], onDelete: Cascade)
  bodyguard Datasheet @relation("Bodyguard", fields: [bodyguardId], references: [id], onDelete: Cascade)

  @@id([leaderId, bodyguardId])
  @@map("leader_attachments")
}

// ─────────────────────────────────────────────────────────────
// User data: army lists
// ─────────────────────────────────────────────────────────────

model ArmyList {
  id           String  @id @default(cuid())
  // Supabase auth user id (auth.users.id)
  ownerId      String  @db.Uuid
  name         String  @db.VarChar(255)
  factionId    Int
  detachmentId Int?
  pointsLimit  Int     @default(2000)
  notes        String?

  faction    Faction        @relation(fields: [factionId], references: [id], onDelete: Restrict)
  detachment Detachment?    @relation(fields: [detachmentId], references: [id], onDelete: SetNull)
  units      ArmyListUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("army_lists")
}

model ArmyListUnit {
  id            String  @id @default(cuid())
  armyListId    String
  datasheetId   Int
  unitSizeId    Int
  enhancementId Int?
  // Set when this unit is a Leader attached to another unit in the same list
  attachedToId  String?
  sortOrder     Int     @default(0)
  // Free-text wargear choices until wargear options are modelled properly
  wargearNotes  String?

  armyList    ArmyList       @relation(fields: [armyListId], references: [id], onDelete: Cascade)
  datasheet   Datasheet      @relation(fields: [datasheetId], references: [id], onDelete: Restrict)
  unitSize    UnitSize       @relation(fields: [unitSizeId], references: [id], onDelete: Restrict)
  enhancement Enhancement?   @relation(fields: [enhancementId], references: [id], onDelete: SetNull)
  attachedTo  ArmyListUnit?  @relation("LeaderInList", fields: [attachedToId], references: [id], onDelete: SetNull)
  leaders     ArmyListUnit[] @relation("LeaderInList")

  @@index([armyListId])
  @@map("army_list_units")
}
