# Copy to .env.local for local development.
#
# Against the local Supabase stack: run `npm run db:start` and copy the API URL
# and publishable key it prints (or run `npx supabase status`).
# Against hosted Supabase: the values in .env.production.
#
# Cloudflare bindings (KV, R2) need no env vars: they are declared in
# cloudflare.config.ts and simulated locally by `npm run dev`.

NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
