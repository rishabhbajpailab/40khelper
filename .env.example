# Copy to .env.local (Next.js) and .env (Prisma CLI), then fill in.
# Works with any PostgreSQL 14+ host: local Docker, a managed provider, or self-hosted.

# Connection the app uses at runtime. If you put a pooler such as PgBouncer in front
# of Postgres, point this at the pooler and add ?pgbouncer=true.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/40khelper"
# Direct connection for Prisma Migrate. Without a pooler, use the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/40khelper"

# Supabase (auth / owner of army lists)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
