# Copy to .env.local (Next.js) and .env (Prisma CLI), then fill in.
# On Vercel these are injected automatically when a Vercel Postgres store is linked.

# Pooled connection (used by the app at runtime)
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:5432/DB?pgbouncer=true&connect_timeout=15"
# Direct connection (used by Prisma for migrations)
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/DB"

# Supabase (auth / owner of army lists)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
