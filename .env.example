# Copy to .env.local and fill in.
#
# Local development: run `npx supabase start` and copy the API URL and
# publishable key it prints (or run `npx supabase status`).
# Hosted: Supabase dashboard -> Project Settings -> API Keys.
# The legacy "anon" key also works as the publishable key.

NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
