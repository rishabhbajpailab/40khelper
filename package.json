{
  "name": "40khelper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vinext-cloudflare deploy",
    "lint": "next lint",
    "typecheck": "cf workers types && tsc --noEmit",
    "cf:types": "cf workers types",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local --schema public > types/database.ts",
    "data:import": "node --env-file-if-exists=.env.local scripts/import-data.ts",
    "test": "node --test \"utils/**/*.test.ts\""
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vinext/cloudflare": "^1.4.0",
    "autoprefixer": "10.4.14",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "framer-motion": "^12.0.0",
    "next": "^15.5.29",
    "postcss": "8.4.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "react-toastify": "^11.2.0",
    "tailwindcss": "3.3.2",
    "typescript": "^5.9.3",
    "vinext": "^1.4.6",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.2",
    "supabase": "^3.2.0",
    "vite": "^8.3.0"
  },
  "type": "module"
}
